# Gemini API key used for fact extraction, entity resolution, and comparison reasoning.
GEMINI_API_KEY=your_gemini_api_key_here

# Model used for all LLM calls. Update to whatever current model your account has access to.
GEMINI_MODEL=gemini-2.5-flash

# SQLite database file (relative to project root, or an absolute path).
DATABASE_URL=sqlite:///./data/factlayer.db

# Where uploaded PDFs and the vector store are persisted on disk.
DATA_DIR=./data

# FastAPI server settings.
API_HOST=0.0.0.0
API_PORT=8000

# Base URL the Streamlit frontend uses to call the API.
API_BASE_URL=http://localhost:8000

# Chunking parameters.
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200

# Candidate retrieval parameters.
CANDIDATE_TOP_K=8
